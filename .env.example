# Names of every key go here, no values.
# Real values: .env.local (your laptop) and Vercel -> Settings -> Environment Variables.
MBTA_API_KEY=   # optional, free at https://api-v3.mbta.com (raises the rate limit)
DATABASE_URL=   # Tiger Data connection string (postgres://...)
GEMINI_API_KEY= # Google AI Studio key, for the AI check
GOOGLE_PLACES_API_KEY= # optional: Places API (New) key, adds a photo to nearby gifts. Without it My World uses the OpenStreetMap snapshot (no key). Server only; set a budget and quota cap.
